# Git-secrets false positives allowlist
# These patterns are whitelisted because they are examples, tests, or documentation

# Test data and examples
Test@1234567890
Test123456!
test-connection
your-api-key
secret-here
demo-token

# Documentation and comments
Evolution API no firma sus webhooks
Query param.*token=
WEBHOOK_VERIFY_TOKEN
accessToken
invitationToken
refreshToken
apikey.*secret
EVOLUTION_API_KEY.*your-api-key

# Test files patterns
\.test\.ts:.*password
\.test\.ts:.*token
\.test\.ts:.*secret
e2e/.*\.ts:.*password
e2e/.*\.ts:.*token
__tests__/.*password
__tests__/.*token

# Configuration examples
\.env\.example:.*password
\.env\.example:.*token
\.env\.example:.*secret
\.env\.example:.*key
scripts/.*password
scripts/.*token
docs/.*password
docs/.*token
docs/.*EVOLUTION_API_KEY
