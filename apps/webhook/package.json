    "@bcp/domain": "workspace:*",
    "@bcp/infrastructure": "workspace:*",
    "bullmq": "^5.34.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "ioredis": "5.10.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.8.3",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2"
  }
