{
  "name": "@bcp/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bcp/application": "workspace:*",
    "@bcp/contracts": "workspace:*",
    "@bcp/domain": "workspace:*",
    "@bcp/infrastructure": "workspace:*",
    "@bcp/provider-fake": "workspace:*",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.34.6",
    "csv-parse": "^7.0.1",
    "ioredis": "5.10.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
