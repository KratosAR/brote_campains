generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder — modelos reales se agregan en Sprint 2+
model _Placeholder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@map("_placeholder")
}
