# Base de datos
DATABASE_URL="postgresql://bcp:bcp_dev_password@localhost:5433/bcp"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generar con: openssl rand -hex 32
JWT_SECRET="change-me-at-least-32-characters-long-secret"
