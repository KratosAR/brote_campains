# Base de datos
# Para producción o testing de carga, agregar parámetros de conexión:
# ?schema=public&connection_timeout=5&statement_timeout=30000
DATABASE_URL="postgresql://bcp:bcp_dev_password@localhost:5433/bcp"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generar con: openssl rand -hex 32
JWT_SECRET="change-me-at-least-32-characters-long-secret"
JWT_REFRESH_SECRET="change-me-at-least-32-characters-long-refresh"

# Cifrado de credenciales de Provider (AES-256)
ENCRYPTION_KEY="change-me-at-least-32-characters-long-encryption"

# Bcrypt password hashing — higher rounds = slower but more secure
# Development: 6 rounds (~50ms per hash), Production: 12+ rounds (~250ms+ per hash)
BCRYPT_ROUNDS="6"

# App
NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"

# apps/webhook
WEBHOOK_VERIFY_TOKEN="change-me-meta-webhook-verify-token"
META_APP_SECRET="change-me-meta-app-secret"
# Evolution API no firma sus webhooks — este secreto se pasa como ?token= en la URL
# que se configura del lado de Evolution.
EVOLUTION_WEBHOOK_SECRET="change-me-evolution-webhook-secret"

# Providers (fallback cuando una ChannelConnection no trae credentials propias)
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""
EVOLUTION_BASE_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME=""
