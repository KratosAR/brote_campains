{
  "title": "Provider Health",
  "uid": "provider-health",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Provider status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "expr": "provider_health_status", "legendFormat": "{{provider}} ({{workspace}})" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "offline" }, "1": { "text": "online" } } }
          ],
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Provider send latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(provider_latency_ms_bucket[5m])) by (le, provider))",
          "legendFormat": "p50 {{provider}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(provider_latency_ms_bucket[5m])) by (le, provider))",
          "legendFormat": "p95 {{provider}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Messages sent by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(messages_sent_total[5m])) by (provider, status)",
          "legendFormat": "{{provider}} - {{status}}"
        }
      ]
    }
  ]
}
